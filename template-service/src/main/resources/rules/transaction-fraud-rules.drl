package com.neversoft.app.rules;

import com.neversoft.quarkus.transaction.fact.TransactionFact;
import java.math.BigDecimal;

// Rule 1: High Value Transaction
rule "High Value Transaction"
    when
        $fact : TransactionFact(amount > 10000)
    then
        $fact.riskLevel = "HIGH";
        $fact.ruleApplied = "High Value Transaction";
end

// Rule 2: Unusually Large Transaction
rule "Unusually Large Transaction"
    when
        $fact : TransactionFact(amount > 50000)
    then
        $fact.riskLevel = "CRITICAL";
        $fact.fraudDetected = true;
        $fact.ruleApplied = "Unusually Large Transaction";
end

// Rule 3: Suspicious Merchant Category
rule "Suspicious Merchant Category"
    when
        $fact : TransactionFact(description matches "(?i).*(casino|gambling|forex|crypto).*")
    then
        $fact.riskLevel = "HIGH";
        $fact.ruleApplied = "Suspicious Merchant Category";
end

// Rule 4: High Risk Country
rule "High Risk Country"
    when
        $fact : TransactionFact(description matches "(?i).*(afghanistan|iran|iraq|north korea|syria).*")
    then
        $fact.riskLevel = "CRITICAL";
        $fact.fraudDetected = true;
        $fact.ruleApplied = "High Risk Country";
end

// Rule 5: Withdrawal Then Transfer Pattern
rule "Withdrawal Then Transfer Pattern"
    when
        $fact : TransactionFact(type.toString() == "WITHDRAWAL" || type.toString() == "TRANSFER")
    then
        $fact.riskLevel = "MEDIUM";
        $fact.ruleApplied = "Withdrawal Then Transfer Pattern";
end

// Rule 6: Structuring Pattern Detection
rule "Structuring Pattern Detection"
    when
        $fact : TransactionFact(amount > 9000, amount < 10000)
    then
        $fact.riskLevel = "MEDIUM";
        $fact.ruleApplied = "Structuring Pattern Detection";
end

// Rule 7: Multiple Transactions Same Day
rule "Multiple Transactions Same Day"
    when
        $fact : TransactionFact(type.toString() == "DEBIT" || type.toString() == "CREDIT")
    then
        $fact.riskLevel = "LOW";
        $fact.ruleApplied = "Multiple Transactions Same Day";
end

// Rule 8: Approve Low Risk
rule "Approve Low Risk"
    when
        $fact : TransactionFact(riskLevel == "LOW", !fraudDetected)
    then
        $fact.status = com.neversoft.quarkus.transaction.entity.TransactionEntity.TransactionStatus.APPROVED;
end

// Rule 9: Reject Medium Risk
rule "Reject Medium Risk"
    when
        $fact : TransactionFact(riskLevel == "MEDIUM")
    then
        $fact.status = com.neversoft.quarkus.transaction.entity.TransactionEntity.TransactionStatus.REJECTED;
end

// Rule 10: Fraud Detected Critical
rule "Fraud Detected Critical"
    when
        $fact : TransactionFact(riskLevel == "CRITICAL" || fraudDetected == true)
    then
        $fact.status = com.neversoft.quarkus.transaction.entity.TransactionEntity.TransactionStatus.FRAUD_DETECTED;
end
